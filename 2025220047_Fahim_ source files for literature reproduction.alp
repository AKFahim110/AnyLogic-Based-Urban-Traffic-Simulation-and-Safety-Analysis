//test.setText((double)root.queueLS_IL_mean());


queueLengthBs_IL.add((double)root.queueBS_IL_mean());
queueLengthBs_OL.add((double)root.queueBS_OL_mean());

queueLengthLs_IL.add((double)root.queueLS_IL_mean());
queueLengthLs_OL.add((double)root.queueLS_OL_mean());
queueLengthLs_ML.add((double)root.queueLS_ML_mean());

queueLengthEc_IL.add((double)root.queueEC_IL_mean());
queueLengthEc_OL.add((double)root.queueEC_OL_mean());
queueLengthEc_ML.add((double)root.queueEC_ML_mean());

queueLengthKl.add((double)root.queueKl_mean());

averageTimeCar.add((double)(root.timeInModel.getStatistics().mean()));

if(root.timeInModel1.getStatistics().mean() > 0)
{
averageTimeTruck.add((double)root.timeInModel1.getStatistics().mean());

}
]]></AfterSimulationRunCode>
