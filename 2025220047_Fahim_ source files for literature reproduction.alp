{sTrafficLightPhases.switchToNextPhase();}
if(((TramLineNeustadter.nCars(true)==0) && (currentPhaseIndex == 10)))
{sTrafficLightPhases.switchToNextPhase();}
if(LS_stopLineK1a_SR.getSignal().equals(SIGNAL_RED)||LS_stopLineK2a_L.getSignal().equals(SIGNAL_RED))
{queueLs = LS.nCars(true);}
if(BS_stopLineK5a_R.getSignal().equals(SIGNAL_RED)||BS_stopLineK5b_S.getSignal().equals(SIGNAL_RED))
{queueBs = BS.nCars(true);}
if(EC_stopLineK4a_SR.getSignal().equals(SIGNAL_RED)||EC_stopLineK4b_L.getSignal().equals(SIGNAL_RED))
{queueEc = EC.nCars(true);}
if(KL_stopLineK6a_SRL.getSignal().equals(SIGNAL_RED))
{queueKl = KL.nCars(true);}
*/]]></Code>
				</OnPhaseChange>
