			</Presentation>

			<AfterIterationCode><![CDATA[//Variable declaration for the total mean queuelength 
double queueLs_IL = 0, queueLs_OL = 0, queueLs_ML = 0;
double queueBs_IL = 0, queueBs_OL = 0;
double queueEc_IL = 0, queueEc_OL = 0, queueEc_ML =0;
double queueKl = 0;
double avgTimeCar = 0.0 , avgTimeTruck = 0.0;

// Addition of all the simulation run queue lengths.
for (int idx = 0; idx < (double)queueLengthLs_IL.size(); idx++) 
{queueLs_IL += (double)queueLengthLs_IL.get(idx);}
for (int idx = 0; idx < (double)queueLengthLs_OL.size(); idx++) 
{queueLs_OL += (double)queueLengthLs_OL.get(idx);}
for (int idx = 0; idx < (double)queueLengthLs_ML.size(); idx++) 
{queueLs_ML += (double)queueLengthLs_ML.get(idx);}


for (int idx = 0; idx < (double)queueLengthBs_IL.size(); idx++)
{queueBs_IL += (double)queueLengthBs_IL.get(idx);}
for (int idx = 0; idx < (double)queueLengthBs_OL.size(); idx++)
{queueBs_OL += (double)queueLengthBs_OL.get(idx);}


for (int idx = 0; idx < (double)queueLengthEc_IL.size(); idx++)
{queueEc_IL += (double)queueLengthEc_IL.get(idx);}
for (int idx = 0; idx < (double)queueLengthEc_OL.size(); idx++)
{queueEc_OL += (double)queueLengthEc_OL.get(idx);}
for (int idx = 0; idx < (double)queueLengthEc_ML.size(); idx++)
{queueEc_ML += (double)queueLengthEc_ML.get(idx);}


for (int idx = 0; idx < (double)queueLengthKl.size(); idx++)
{queueKl += (double)queueLengthKl.get(idx);}



for (int idx = 0; idx < (double)averageTimeCar.size(); idx++)
{avgTimeCar += (double)averageTimeCar.get(idx);}
for (int idx = 0; idx < (double)averageTimeTruck.size(); idx++)
{avgTimeTruck += (double)averageTimeTruck.get(idx);}

//Finding the mean of all the mean queue length

double mean_Ls_IL = queueLs_IL / (double)queueLengthLs_IL.size();
double mean_Ls_OL = queueLs_OL / (double)queueLengthLs_OL.size();
double mean_Ls_ML = queueLs_ML / (double)queueLengthLs_ML.size();

double mean_Bs_IL = queueBs_IL / (double)queueLengthBs_IL.size();
double mean_Bs_OL = queueBs_OL / (double)queueLengthBs_OL.size();

double mean_Ec_IL = queueEc_IL / (double)queueLengthEc_IL.size();
double mean_Ec_OL = queueEc_OL / (double)queueLengthEc_OL.size();
double mean_Ec_ML = queueEc_ML / (double)queueLengthEc_ML.size();

double mean_Kl = queueKl / (double)queueLengthKl.size();

double mean_Atc = avgTimeCar / (double)averageTimeCar.size();
double mean_Att = avgTimeTruck / (double)averageTimeTruck.size();

// sum of squared differences

double sumdiffsq_Ls_IL = 0, sumdiffsq_Ls_OL = 0, sumdiffsq_Ls_ML = 0;
double sumdiffsq_Bs_IL = 0, sumdiffsq_Bs_OL = 0, sumdiffsq_Bs_ML = 0;
double sumdiffsq_Ec_IL = 0, sumdiffsq_Ec_OL = 0, sumdiffsq_Ec_ML = 0;
double sumdiffsq_Kl = 0;
double sumdiffsq_Atc = 0 ,sumdiffsq_Att = 0 ;	

for (int idx = 0; idx < (double)queueLengthLs_IL.size(); idx++) 
{
sumdiffsq_Ls_IL += ((double)queueLengthLs_IL.get(idx)- mean_Ls_IL)*((double)queueLengthLs_IL.get(idx) - mean_Ls_IL);
}
for (int idx = 0; idx < (double)queueLengthLs_OL.size(); idx++) 
{
sumdiffsq_Ls_OL += ((double)queueLengthLs_OL.get(idx)- mean_Ls_OL)*((double)queueLengthLs_OL.get(idx) - mean_Ls_OL);
}
for (int idx = 0; idx < (double)queueLengthLs_ML.size(); idx++) 
{
sumdiffsq_Ls_ML += ((double)queueLengthLs_ML.get(idx)- mean_Ls_ML)*((double)queueLengthLs_ML.get(idx) - mean_Ls_ML);
}


for (int idx = 0; idx < (double)queueLengthBs_IL.size(); idx++)
{
sumdiffsq_Bs_IL += ((double)queueLengthBs_IL.get(idx)- mean_Bs_IL)*((double)queueLengthBs_IL.get(idx) - mean_Bs_IL);
}
for (int idx = 0; idx < (double)queueLengthBs_OL.size(); idx++)
{
sumdiffsq_Bs_OL += ((double)queueLengthBs_OL.get(idx)- mean_Bs_OL)*((double)queueLengthBs_OL.get(idx) - mean_Bs_OL);
}


for (int idx = 0; idx < (double)queueLengthEc_IL.size(); idx++)
{
sumdiffsq_Ec_IL += ((double)queueLengthEc_IL.get(idx)- mean_Ec_IL)*((double)queueLengthEc_IL.get(idx) - mean_Ec_IL);
}
for (int idx = 0; idx < (double)queueLengthEc_OL.size(); idx++)
{
sumdiffsq_Ec_OL += ((double)queueLengthEc_OL.get(idx)- mean_Ec_OL)*((double)queueLengthEc_OL.get(idx) - mean_Ec_OL);
}
for (int idx = 0; idx < (double)queueLengthEc_ML.size(); idx++)
{
sumdiffsq_Ec_ML += ((double)queueLengthEc_ML.get(idx)- mean_Ec_ML)*((double)queueLengthEc_ML.get(idx) - mean_Ec_ML);
}


for (int idx = 0; idx < (double)queueLengthKl.size(); idx++)
{
sumdiffsq_Kl += ((double)queueLengthKl.get(idx)- mean_Kl)*((double)queueLengthKl.get(idx) - mean_Kl);
}


for (int idx = 0; idx < (double)averageTimeCar.size(); idx++)
{sumdiffsq_Atc += ((double)averageTimeCar.get(idx)- mean_Atc)*((double)averageTimeCar.get(idx) - mean_Atc);}
for (int idx = 0; idx < (double)averageTimeTruck.size(); idx++)
{sumdiffsq_Att += ((double)averageTimeTruck.get(idx)- mean_Att)*((double)averageTimeTruck.get(idx) - mean_Att);}


double sigma_Ls_IL = sqrt( sumdiffsq_Ls_IL / (((double)queueLengthLs_IL.size()-1)*(double)queueLengthLs_IL.size()));
double sigma_Ls_OL = sqrt( sumdiffsq_Ls_OL / (((double)queueLengthLs_OL.size()-1)*(double)queueLengthLs_OL.size()));
double sigma_Ls_ML = sqrt( sumdiffsq_Ls_ML / (((double)queueLengthLs_ML.size()-1)*(double)queueLengthLs_ML.size()));

double sigma_Bs_IL = sqrt( sumdiffsq_Bs_IL / (((double)queueLengthBs_IL.size()-1)*(double)queueLengthBs_IL.size()));
double sigma_Bs_OL = sqrt( sumdiffsq_Bs_OL / (((double)queueLengthBs_OL.size()-1)*(double)queueLengthBs_OL.size()));


double sigma_Ec_IL = sqrt( sumdiffsq_Ec_IL / (((double)queueLengthEc_IL.size()-1)*(double)queueLengthEc_IL.size()));
double sigma_Ec_OL = sqrt( sumdiffsq_Ec_OL / (((double)queueLengthEc_OL.size()-1)*(double)queueLengthEc_OL.size()));
double sigma_Ec_ML = sqrt( sumdiffsq_Ec_ML / (((double)queueLengthEc_ML.size()-1)*(double)queueLengthEc_ML.size()));


double sigma_Kl = sqrt( sumdiffsq_Kl / (((double)queueLengthKl.size()-1)*(double)queueLengthKl.size()));

double sigma_Atc = sqrt( sumdiffsq_Atc / (((double)averageTimeCar.size()-1)*(double)averageTimeCar.size()));
double sigma_Att = sqrt( sumdiffsq_Att / (((double)averageTimeTruck.size()-1)*(double)averageTimeTruck.size()));


double tvalue = 1.660;	


upperLs_IL = (double)mean_Ls_IL + (double)sigma_Ls_IL * tvalue;
lowerLs_IL = (double)mean_Ls_IL - (double)sigma_Ls_IL * tvalue;
upperLs_OL = (double)mean_Ls_OL + (double)sigma_Ls_OL * tvalue;
lowerLs_OL = (double)mean_Ls_OL - (double)sigma_Ls_OL * tvalue;
upperLs_ML = (double)mean_Ls_ML + (double)sigma_Ls_ML * tvalue;
lowerLs_ML = (double)mean_Ls_ML - (double)sigma_Ls_ML * tvalue;

upperBs_IL = (double)mean_Bs_IL + (double)sigma_Bs_IL * tvalue;
lowerBs_IL = (double)mean_Bs_IL - (double)sigma_Bs_IL * tvalue;
upperBs_OL = (double)mean_Bs_OL + (double)sigma_Bs_OL * tvalue;
lowerBs_OL = (double)mean_Bs_OL - (double)sigma_Bs_OL * tvalue;	


upperEc_IL = (double)mean_Ec_IL + (double)sigma_Ec_IL * tvalue;
lowerEc_IL = (double)mean_Ec_IL - (double)sigma_Ec_IL * tvalue;
upperEc_OL = (double)mean_Ec_OL + (double)sigma_Ec_OL * tvalue;
lowerEc_OL = (double)mean_Ec_OL - (double)sigma_Ec_OL * tvalue;
upperEc_ML = (double)mean_Ec_ML + (double)sigma_Ec_ML * tvalue;
lowerEc_ML = (double)mean_Ec_ML - (double)sigma_Ec_ML * tvalue;

upperKl = (double)mean_Kl + (double)sigma_Kl * tvalue;
lowerKl = (double)mean_Kl - (double)sigma_Kl * tvalue;


upperATC = (double)mean_Atc + (double)sigma_Atc * tvalue;
lowerATC = (double)mean_Atc - (double)sigma_Atc * tvalue;

upperATT = (double)mean_Att + (double)sigma_Att * tvalue;
lowerATT = (double)mean_Att - (double)sigma_Att * tvalue;

textLs_IL.setText(format((lowerLs_IL)) + "< Queue Length of Inner Lane - Ls <" + format((upperLs_IL)));
textLs_OL.setText(format((lowerLs_OL)) + "< Queue Length of Outer Lane - Ls <" + format((upperLs_OL)));
textLs_ML.setText(format((lowerLs_ML)) + "< Queue Length of Middle Lane - Ls <" + format((upperLs_ML)));

textBs_IL.setText(format((lowerBs_IL)) + "< Queue Length of Inner Lane - Bs <" + format((upperBs_IL)));
textBs_OL.setText(format((lowerBs_OL)) + "< Queue Length of Outer Lane - Bs <" + format((upperBs_OL)));


textEc_IL.setText(format((lowerEc_IL)) + "< Queue Length of Inner Lane - Ec <" + format((upperEc_IL)));
textEc_OL.setText(format((lowerEc_OL)) + "< Queue Length of Outer Lane - Ec <" + format((upperEc_OL)));
textEc_ML.setText(format((lowerEc_ML)) + "< Queue Length of Middle Lane - Ec <" + format((upperEc_ML)));


textKl.setText(format((lowerKl)) + "< Queue Length of Street - Kl <" + format((upperKl)));

textATC.setText(format(lowerATC) + "< Average Time of Cars  <" + format(upperATC));
textATT.setText(format(lowerATT) + "< Average Time of Trucks  <" + format(upperATT));]]></AfterIterationCode>
