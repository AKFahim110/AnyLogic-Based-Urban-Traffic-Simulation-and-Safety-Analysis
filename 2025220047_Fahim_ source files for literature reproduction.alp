}
if(EC_stopLineK4a_SR.getSignal().equals(SIGNAL_GREEN) )
{
	for (int i =0; i < queueEC_IL_list.size();i++)
	{
	queue_IL += queueEC_IL_list.get(i);
	}
	if(queue_IL > 0)
	{
	queueEC_IL_main.add(queue_IL);
	}
	queueEC_IL_list.clear();
}

if((vehicle.getLaneIndex() == 1) && (EC_stopLineK4b_L.getSignal().equals(SIGNAL_RED)) && (vehicle.getSpeed(KPH) < 10) )
{
queueOL_EC++;
