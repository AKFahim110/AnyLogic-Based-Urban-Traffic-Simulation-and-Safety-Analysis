queueOL_EC=0;
}
if(EC_stopLineK4b_L.getSignal().equals(SIGNAL_GREEN))
{
	for (int i =0; i < queueEC_OL_list.size();i++)
	{
	queue_OL += queueEC_OL_list.get(i);
	}
	if(queue_OL > 0)
	{
	queueEC_OL_main.add(queue_OL);
	}
	queueEC_OL_list.clear();
}

