				<OnPhaseChange Class="CodeValue">
					<Code><![CDATA[if(currentPhaseIndex==0)
{
WaitLights_Kl.freeAll();
WaitLights_Ec.freeAll();
}
if(currentPhaseIndex==2)
{
WaitLights_Kl.freeAll();
}
if(currentPhaseIndex==4)
{
WaitLights_Kl.freeAll();
WaitLights_Bs.freeAll();
}
if(currentPhaseIndex==6)
{ 
WaitLights_Bs.freeAll();
WaitLights_Ls.freeAll();
}
if(currentPhaseIndex==8)
{
WaitLights_Ls.freeAll();
}
if(currentPhaseIndex==10)
{
WaitLights_Ec.freeAll();
WaitLights_Kl.freeAll();
}


if((TramLineIkea.nCars(true)==0) && (currentPhaseIndex == 4))
{
sTrafficLightPhases.switchToNextPhase();
}

if((TramLineKl.nCars(false)==0) && (currentPhaseIndex == 10))
{
sTrafficLightPhases.switchToNextPhase();
}



/*
if(((TramLineKl.nCars(false)==0) && (currentPhaseIndex == 10)))
{sTrafficLightPhases.switchToNextPhase();} 
