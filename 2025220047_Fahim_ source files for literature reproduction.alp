			<AfterSimulationRunCode><![CDATA[/*root.queueLS_OL_mean1 = (double)root.queueLS_OL_mean();
root.queueLS_IL_mean1 = (double)root.queueLS_IL_mean();
root.queueLS_ML_mean1 = (double)root.queueLS_ML_mean();
root.queueBS_IL_mean1 = (double)root.queueBS_IL_mean();
root.queueBS_OL_mean1 = (double)root.queueBS_OL_mean();
root.queueEC_IL_mean1 = (double)root.queueEC_IL_mean();
root.queueEC_OL_mean1 = (double)root.queueEC_OL_mean();
