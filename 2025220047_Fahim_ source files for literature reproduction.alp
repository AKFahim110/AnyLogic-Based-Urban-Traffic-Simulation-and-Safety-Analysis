						<Type><![CDATA[Car]]></Type>
					</Parameter>
					<Body><![CDATA[double queue_IL=0;
double queue_OL=0;
double queue_ML=0;

if(vehicle.getLaneIndex() == 0 && LS_stopLineK1a_SR.getSignal().equals(SIGNAL_RED) && vehicle.getSpeed(KPH) < 10 )
{
queueIL_LS++;
queueLS_IL_list.add(queueIL_LS);
queueIL_LS=0;
}
if(LS_stopLineK1a_SR.getSignal().equals(SIGNAL_GREEN))
{
for (int i =0; i < queueLS_IL_list.size();i++)
{
queue_IL += queueLS_IL_list.get(i);
}
if(queue_IL > 0)
{queueLS_IL_main.add(queue_IL);}
queueLS_IL_list.clear();
}
if(vehicle.getLaneIndex() == 1 && LS_stopLineK2a_L.getSignal().equals(SIGNAL_RED) && vehicle.getSpeed(KPH) < 10 )
{
queueOL_LS++;
queueLS_OL_list.add(queueOL_LS);
queueOL_LS=0;
}
if(LS_stopLineK2a_L.getSignal().equals(SIGNAL_GREEN))
{
for (int i =0; i < queueLS_OL_list.size();i++)
{
queue_OL += queueLS_OL_list.get(i);
System.out.println(queue_OL);
}
if(queue_OL > 0)
{
queueLS_OL_main.add(queue_OL);
System.out.println("inside" + queueLS_OL_main.size());
}
queueLS_OL_list.clear();
}
